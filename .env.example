HOST=0.0.0.0
PORT=1337

# Generate each of these once, then keep them: changing APP_KEYS invalidates
# sessions, and changing ADMIN_JWT_SECRET logs every admin out.
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# APP_KEYS takes four comma-separated values; the rest take one each.
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me
ENCRYPTION_KEY=replace-me

# Matches docker-compose.yml. Local development credentials only — the compose
# file has the same values, so there is nothing secret here.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=strapi_db
DATABASE_USERNAME=strapi_user
DATABASE_PASSWORD=strapi_password
DATABASE_SSL=false
DATABASE_FILENAME=
