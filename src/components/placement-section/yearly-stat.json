    "highest_package": { "type": "string", "required": false, "maxLength": 20 },
    "highest_package_intl": { "type": "string", "required": false, "maxLength": 20 },
    "package_bands": {
      "type": "component", "repeatable": true,
      "component": "placement-section.package-band", "max": 8
    }
  }
}
